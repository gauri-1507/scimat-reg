# Copy to .env. These are SERVER-ONLY secrets: never prefix with VITE_ and never commit .env.
# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string (16+ chars) for GET /api/admin/registrations. Leave empty to disable that endpoint.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

PORT=3001
# Set to 1 when deployed behind a proxy (Render, Railway, Fly, nginx) so rate limiting sees real client IPs.
TRUST_PROXY=

# UPI payments go here (public values, shown on the page as a QR code). Use your real UPI ID.
VITE_UPI_ID=yourname@bank
VITE_UPI_NAME=Sci-Mat Open Society
